# ==============================================================================
# CAMPUS PULSE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or set environment variables in your deployment environment.
# DO NOT commit real secrets or credentials into version control!

# --- Serverpod Backend Configuration ---
SERVERPOD_SERVER_ID=default
SERVERPOD_RUN_MODE=development
SERVERPOD_PORT=8080
SERVERPOD_PUBLIC_HOST=localhost
SERVERPOD_PUBLIC_PORT=8080
SERVERPOD_PUBLIC_SCHEME=http

# --- PostgreSQL Database Credentials ---
SERVERPOD_DATABASE_HOST=localhost
SERVERPOD_DATABASE_PORT=5432
SERVERPOD_DATABASE_NAME=campus_pulse
SERVERPOD_DATABASE_USER=postgres
SERVERPOD_DATABASE_PASSWORD=your_secure_postgres_password_here

# --- Serverpod Service Secret Key ---
# Used for internal service communication and session tokens
SERVERPOD_SERVICE_SECRET=your_32_character_minimum_random_secret_here

# --- Redis (Optional for horizontal scaling & streaming bus) ---
SERVERPOD_REDIS_ENABLED=false
SERVERPOD_REDIS_HOST=localhost
SERVERPOD_REDIS_PORT=6379

# --- Flutter Client Configuration ---
# Passed at build time via --dart-define=SERVER_URL=https://api.yourdomain.com/
FLUTTER_APP_SERVER_URL=http://localhost:8080/
FLUTTER_APP_ENV=development

